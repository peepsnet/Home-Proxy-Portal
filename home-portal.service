[Unit]
Description=Home Portal (password-protected LAN web gateway)
After=network-online.target
Wants=network-online.target

[Service]
User=homeportal
Group=homeportal
WorkingDirectory=/opt/home-portal
ExecStart=/opt/home-portal/venv/bin/python /opt/home-portal/portal.py
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/home-portal

[Install]
WantedBy=multi-user.target
